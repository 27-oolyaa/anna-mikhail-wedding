const SPREADSHEET_ID='1CfrLv8uQzaZxvIr_RKTBeHCGeP6lgw9jiWwc_xAjre0';
const SHEET_NAME='Ответы гостей';
function doGet(){return ContentService.createTextOutput('Свадебное приглашение: сервер работает').setMimeType(ContentService.MimeType.TEXT)}
function doPost(e){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const ss=SpreadsheetApp.openById(SPREADSHEET_ID);let sh=ss.getSheetByName(SHEET_NAME);if(!sh)sh=ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0)sh.appendRow(['Дата ответа','Имя и фамилия','Присутствие','Сопровождающий','Пожелания / комментарии']);const p=e&&e.parameter?e.parameter:{};sh.appendRow([new Date(),p.name||'',p.attendance||'',p.plusOne||'',p.comments||'']);return ContentService.createTextOutput('OK')}finally{lock.releaseLock()}}